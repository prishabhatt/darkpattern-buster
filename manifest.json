{
  "manifest_version": 3,
  "name": "DarkPattern Buster",
  "version": "1.0",
  "description": "Honesty audit and real-time dark pattern detector for this page.",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5001/*"
  ]
}